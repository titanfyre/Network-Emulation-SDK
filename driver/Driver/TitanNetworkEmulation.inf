[Version]
Signature="$Windows NT$"
Class=System
ClassGUID={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
CatalogFile=TitanNetworkEmulation.cat
DriverVer=10/25/2026,0.1.0.0
PnpLockdown=1
[Manufacturer]
%Provider%=Models,NTamd64.10.0...19041
[Models.NTamd64.10.0...19041]
%Device%=TraceInstall,ROOT\TitanNetworkEmulation
[SourceDisksNames]
1=%Disk%
[SourceDisksFiles]
TitanNetworkEmulation.sys=1
[DestinationDirs]
DriverFiles=13
[DriverFiles]
TitanNetworkEmulation.sys
[TraceInstall.NT]
CopyFiles=DriverFiles
[TraceInstall.NT.HW]
AddReg=DeviceSecurity
[DeviceSecurity]
HKR,,Security,0,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"
HKR,,DeviceCharacteristics,0x00010001,0x00000100
[TraceInstall.NT.Services]
AddService=TitanNetworkEmulation,0x00000002,TraceService
[TraceService]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\TitanNetworkEmulation.sys
[TraceInstall.NT.Wdf]
KmdfService=TitanNetworkEmulation,TraceWdf
[TraceWdf]
KmdfLibraryVersion=1.31
[Strings]
Provider="Titanfyre"
Device="Titan Network Emulation"
Disk="Titan Network Filter installation media"
